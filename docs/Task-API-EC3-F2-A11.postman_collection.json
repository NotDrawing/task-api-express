            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{missingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{missingId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', () => pm.response.to.have.status(404));",
                  "pm.test('code TASK_NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('TASK_NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
