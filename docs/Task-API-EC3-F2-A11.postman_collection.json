              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('openapi 3.1.0', () => pm.expect(body.openapi).to.eql('3.1.0'));",
                  "pm.test('define bearerAuth', () => pm.expect(body.components.securitySchemes.bearerAuth.scheme).to.eql('bearer'));",
                  "pm.test('incluye /api/auth/me', () => pm.expect(body.paths['/api/auth/me']).to.be.an('object'));"
