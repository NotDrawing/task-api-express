    {
      "name": "02 Autenticación pública",
      "item": [
        {
          "name": "POST /api/auth/register (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"ana.torres@example.com\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Correo único por ejecución para evitar 409 al repetir la colección.",
                  "const email = 'ana.' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set('userEmail', email);",
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.email = email;",
                  "pm.request.body.raw = JSON.stringify(body, null, 2);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve data.user', () => pm.expect(body.data.user).to.be.an('object'));",
                  "pm.test('Rol siempre user', () => pm.expect(body.data.user.role).to.eql('user'));",
                  "pm.test('No expone passwordHash', () => pm.expect(body.data.user.passwordHash).to.be.undefined);",
                  "pm.test('No expone password', () => pm.expect(body.data.user.password).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST register intentando rol admin (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Intruso\",\n  \"email\": \"intruso@example.com\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\",\n  \"role\": \"admin\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 422', () => pm.response.to.have.status(422));",
                  "const body = pm.response.json();",
                  "pm.test('code AUTH_VALIDATION_ERROR', () => pm.expect(body.error.code).to.eql('AUTH_VALIDATION_ERROR'));",
                  "pm.test('role marcado como no permitido', () => { const d = body.error.details || []; pm.expect(d.some((i) => i.field === 'role')).to.eql(true); });",
                  "pm.test('Incluye requestId', () => pm.expect(body.error.requestId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST register duplicado (409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', () => pm.response.to.have.status(409));",
                  "pm.test('code USER_EMAIL_EXISTS', () => pm.expect(pm.response.json().error.code).to.eql('USER_EMAIL_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (200)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve user, accessToken, tokenType y expiresIn', () => { pm.expect(body.data.user).to.be.an('object'); pm.expect(body.data.accessToken).to.be.a('string'); pm.expect(body.data.tokenType).to.eql('Bearer'); pm.expect(body.data.expiresIn).to.be.a('string'); });",
                  "pm.test('No expone passwordHash', () => pm.expect(body.data.user.passwordHash).to.be.undefined);",
                  "pm.collectionVariables.set('token', body.data.accessToken);"
                ]
              }
            }
          ]
        },
